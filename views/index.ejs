<!DOCTYPE html>
<html lang="en">
<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="styles/style.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book Basket</title>
</head>
<body class="container" id="body">
    <div class="header container">
        <h1>SAMEER KHAN</h1>
        <h2>BOOKS I'VE READ</h2>
    </div>
    <div class="intro container">
        <h4>Welcome to Book Basket, my personal collection of books that have left a lasting impression on me.  Here, 
            I share the stories I've explored, complete with my honest reviews and ratings. From timeless classics to contemporary gems, each 
            book in my basket offers something unique — whether it's a thought-provoking plot, memorable characters, or lessons that resonate beyond
             the pages. Dive in, discover new reads, and join me on this literary journey as we uncover stories that inspire, entertain, and enlighten.</h4>
    </div>
    <div class="sort my-3 container">
        <form action="/" method="post">
            Sort By: <select name="order" onchange="this.form.submit()">
                <option value="id" selected>Choose here </option>
                <option value="author">sort by author name</option>
                <option value="title">sort by title</option>
            </select>
            <!-- <input type="submit" class="btn btn-sm btn-light" value="submit" /> -->
        </form>
    </div>
    <% if(locals.books) { %>
        <% books.forEach((book) => { %>
    <div class = "books my-3 container">
        <img src="https://covers.openlibrary.org/b/olid/<%= book.olid %>-M.jpg" class="card-img-top" alt="...">
        <div class="card my-4">
            <h5><%= (book.title).toUpperCase() %> BY <%= (book.author).toUpperCase() %></h5>
            <small>date read: <%= book.date_read %>, How strong i recommend <%= book.rating %></small>
            <div class="card-body">
              <p class="card-text"><%= book.review %></p>
            </div>
          </div>
    </div>
    <% })} %>
</body>
</html>